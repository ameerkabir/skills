---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { resolveSiteIdentity } from "../utils/site-identity";
import { getUiStrings } from "../utils/ui-strings";
import { localizedHref } from "../utils/localized-href";

const locale = Astro.locals.locale;
const t = await getUiStrings(locale);
const { siteTitle, siteTagline } = resolveSiteIdentity(await getSiteSettings(), locale, t);
const { entry: home } = await getEmDashEntry("homepage", "home", { locale });
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	locale,
	orderBy: { published_at: "desc" },
	limit: 3,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
}
const cards = home
	? [
			{ title: home.data.intro_card1_title, body: home.data.intro_card1_body },
			{ title: home.data.intro_card2_title, body: home.data.intro_card2_body },
			{ title: home.data.intro_card3_title, body: home.data.intro_card3_body },
		].filter((c) => c.title)
	: [];
---

<Base title={siteTitle} description={siteTagline}>
	<section class:list={["hero", { "hero--image": home?.data.hero_image }]}>
		{home?.data.hero_image && <Image image={home.data.hero_image} class="hero__bg" priority />}
		<div class="hero__content">
			{home?.data.hero_kicker && <p class="hero__kicker">{home.data.hero_kicker}</p>}
			<h1>{home?.data.hero_heading ?? siteTitle}</h1>
			<p class="hero__body">{home?.data.hero_body ?? siteTagline}</p>
			<div class="hero__actions">
				<a href={localizedHref(locale, "/register")} class="btn btn--primary">{t["home.cta_join"] ?? "Become a member"}</a>
				<a href={localizedHref(locale, "/about")} class="btn btn--ghost">{t["home.cta_about"] ?? "About us"}</a>
			</div>
		</div>
	</section>

	{cards.length > 0 && (
		<section class="card-grid intro">
			{cards.map((c) => (
				<div class="card">
					<h3>{c.title}</h3>
					<p>{c.body}</p>
				</div>
			))}
		</section>
	)}

	{posts.length > 0 && (
		<section class="news">
			<div class="news__header">
				<h2>{t["home.news_heading"] ?? "Latest news"}</h2>
				<a href={localizedHref(locale, "/posts")}>{t["home.view_all"] ?? "View all"}</a>
			</div>
			<div class="card-grid">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		</section>
	)}

	{home?.data.cta_heading && (
		<section class="cta">
			<h2>{home.data.cta_heading}</h2>
			<p>{home.data.cta_body}</p>
			<a href={localizedHref(locale, "/register")} class="btn btn--primary">{t["home.cta_join"] ?? "Become a member"}</a>
		</section>
	)}
</Base>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		margin: -2.5rem -1.25rem 3rem;
		padding: 5rem 1.25rem;
		background: linear-gradient(135deg, var(--color-accent-soft), var(--color-bg));
		border-bottom: 1px solid var(--color-border);
	}
	.hero--image { color: #fff; }
	.hero :global(.hero__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
	.hero--image::after { content: ""; position: absolute; inset: 0; background: rgb(0 0 0 / 0.45); z-index: 0; }
	.hero__content { position: relative; z-index: 1; max-width: var(--content-width); }
	.hero__kicker { color: var(--color-accent); font-weight: 600; font-size: 1.125rem; }
	.hero--image .hero__kicker { color: inherit; opacity: 0.9; }
	.hero__body { font-size: 1.125rem; max-width: 46ch; margin-bottom: 2rem; }
	.hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
	.intro { margin-bottom: 3rem; }
	.news { margin-bottom: 3rem; }
	.news__header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.cta { text-align: center; padding: 2.5rem 1.5rem; border-radius: var(--radius); background: var(--color-accent-soft); }
</style>
