---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getUiStrings } from "../../utils/ui-strings";
import { localizedHref } from "../../utils/localized-href";

const locale = Astro.locals.locale;
const t = await getUiStrings(locale);
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	locale,
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
}
---

<Base title={t["news.heading"] ?? "News"}>
	<h1>{t["news.heading"] ?? "News"}</h1>
	{posts.length === 0 ? <p>{t["news.empty"] ?? "No news yet."}</p> : (
		<div class="card-grid">{posts.map((post) => <PostCard post={post} />)}</div>
	)}
	{nextCursor && (
		<p class="pager"><a href={localizedHref(locale, `/posts?cursor=${encodeURIComponent(nextCursor)}`)}>→</a></p>
	)}
</Base>
