---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { getUiStrings } from "../utils/ui-strings";

const locale = Astro.locals.locale;
const t = await getUiStrings(locale);
// Contact details (address, phone, email, hours) are the `pages` entry with
// slug `contact`, edited in the admin. They render above the form; the form
// itself is code, and its wording lives in the `contact.*` ui_strings.
const { entry: details, cacheHint } = await getEmDashEntry("pages", "contact", { locale });
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
}
---

<Base
	title={t["contact.heading"] ?? "Contact us"}
	content={details ? { collection: "pages", id: details.data.id, slug: "contact" } : undefined}
>
	<div class="contact">
		<h1>{t["contact.heading"] ?? "Contact us"}</h1>
		{details && (
			<section class="card contact-details">
				<h2 {...details.edit.title}>{details.data.title}</h2>
				<div class="prose">
					<PortableText value={details.data.content} />
				</div>
			</section>
		)}
		<section class="contact-form">
			<h2>{t["contact.form_heading"] ?? "Send us a message"}</h2>
			<p>{t["contact.intro"] ?? "If you have a query, please contact us using the following form."}</p>
			<form
				class="form"
				data-endpoint="/_emdash/api/plugins/site-forms/contact"
				data-msg-ok={t["contact.success"] ?? "Thank you. Your message has been sent."}
				data-msg-error={t["contact.error"] ?? "Something went wrong. Please try again."}
				data-msg-rate-limited={t["form.rate_limited"] ?? "Too many submissions. Please try again later."}
			>
				<label>{t["contact.name"] ?? "Name"} *<input name="name" required autocomplete="name" /></label>
				<label>{t["contact.email"] ?? "Email"} *<input name="email" type="email" required autocomplete="email" /></label>
				<label>{t["contact.phone"] ?? "Phone (optional)"}<input name="phone" type="tel" autocomplete="tel" /></label>
				<label>{t["contact.message"] ?? "Message"} *<textarea name="message" rows="6" required></textarea></label>
				<input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<div data-notice hidden role="status"></div>
				<button type="submit" class="btn btn--primary">{t["contact.submit"] ?? "Send message"}</button>
			</form>
		</section>
	</div>
</Base>

<script>
	import "../scripts/form-submit";
</script>

<style>
	/* Details on top, form below: one column at every width. */
	.contact { max-width: var(--content-width); margin: 0 auto; display: grid; gap: 2rem; }
	.contact h1 { margin-bottom: 0; }
	.contact-details h2, .contact-form h2 { font-size: 1.25rem; margin-top: 0; }
	.contact-details :global(h3) { font-size: 1rem; margin: 1.25rem 0 0.25rem; }
	.contact-details :global(p) { margin: 0 0 0.25rem; }
	.contact-form > p { color: var(--color-text-muted); }
</style>
